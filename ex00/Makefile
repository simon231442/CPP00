Name = megaphone

################################################################################
#                               DIRECTORIES                                    #
################################################################################

OBJ_DIR = obj

################################################################################
#                                MINIRT SRC                                    #
################################################################################

SOURCE = megaphone.cpp

################################################################################
#                             COMPILER OPTIONS                                 #
################################################################################

CCPP = c++
CPPFLAGS = -Wall -Wextra -Werror -std=c++98

OBJETS = $(SOURCE:%.cpp=$(OBJ_DIR)/%.o)

################################################################################
#                              TARGETS & RULES                                 #
################################################################################

$(NAME) : $(OBJ_DIR)
	$(CCPP) $(CPPFLAGS) $(OBJ_DIR) -o $(NAME)

$(OBJ_DIR)/%.o : %.cpp | $(OBJ_DIR)
	$(CCPP) $(CPPFLAGS) -c $< -o $@

$(OBJ_DIR) :
	mkdir -p $(OBJ_DIR)

clean :
	rm -rf $(OBJ_DIR)

fclean : clean
	rm $(NAME)

re : fclean
	all

.PHONY : all clean fclean re
